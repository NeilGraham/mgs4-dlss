<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MGS4 DLSS Launcher" Height="880" Width="1180" MinHeight="560" MinWidth="920"
        Background="#0B0B0C" WindowStartupLocation="CenterScreen" TextOptions.TextFormattingMode="Ideal">
  <!-- No system title bar: the client area starts at the very top of the window so the key art can fill the strip
       the caption used to have, and the three buttons at its right are drawn here instead. CaptionHeight is what
       is left draggable - it is raised in code to the whole header's height, so the bar drags like a title bar.
       The glass frame is kept so the window still has Windows' own shadow and rounded corners. -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0"
                        GlassFrameThickness="0,32,0,0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="Card" Color="#151517"/>
    <SolidColorBrush x:Key="Line" Color="#26262A"/>
    <SolidColorBrush x:Key="Text" Color="#ECECEE"/>
    <SolidColorBrush x:Key="Muted" Color="#97979F"/>
    <SolidColorBrush x:Key="Accent" Color="#7C9CFF"/>
    <!-- 6 wide with a 4 px thumb, which is what Windows 11 draws for an idle overlay scrollbar.

         MinWidth is the setter that matters. A style like this one layers over the theme's, it does not replace
         it, and the theme's ScrollBar style carries MinWidth = the system scrollbar width (17): with only Width
         set here the bar came out 17 wide wearing this template - the thumb was ours, the width was Windows'.

         The thumb's length is not settled here either. Track sizes it by the viewport-to-content ratio, and on a
         short window over a 400-row list that is a few pixels; a MinHeight on the Thumb only made it *draw*
         taller than Track thought it was, so it overhung the track's end and dragged wrong. ScrollThumb.cs gives
         the Track an inflated viewport instead, so the thumb never goes under a comfortable length and the drag
         arithmetic agrees with what is drawn. -->
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="6"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="t" CornerRadius="2" Background="#35353C" Margin="1,2"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="#4A4A54"/>
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="t" Property="Background" Value="#5A5A66"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <!-- The same bar lying down, for the rare horizontal one (a wide line in a text box). Without this the
           vertical template was used sideways: 6 wide, 17 tall, and the thumb running the wrong way. -->
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="6"/>
          <Setter Property="MinHeight" Value="0"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent">
                  <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.Thumb>
                      <Thumb>
                        <Thumb.Template>
                          <ControlTemplate TargetType="Thumb">
                            <Border x:Name="t" CornerRadius="2" Background="#35353C" Margin="2,1"/>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="Background" Value="#4A4A54"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Thumb.Template>
                      </Thumb>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                    </Track.IncreaseRepeatButton>
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                    </Track.DecreaseRepeatButton>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- A scroller whose bar lies over the content instead of beside it, for the picked-scene panel: the frame at
         its head runs edge to edge, and a bar in a column of its own would have cut a strip off the right of it.
         The bar is the same 6 px one, so it costs nothing to see through. -->
    <Style x:Key="OverlayScroll" TargetType="ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollViewer">
            <Grid Background="{TemplateBinding Background}">
              <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                      CanContentScroll="{TemplateBinding CanContentScroll}"
                                      CanHorizontallyScroll="False" CanVerticallyScroll="False"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"/>
              <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Orientation="Vertical"
                         Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                         ViewportSize="{TemplateBinding ViewportHeight}"
                         Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                         Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Flat" TargetType="Button">
      <Setter Property="Foreground" Value="#ECECEE"/>
      <Setter Property="Background" Value="#212125"/>
      <Setter Property="BorderBrush" Value="#35353C"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#313137"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Flat}">
      <Setter Property="Background" Value="#3A5BD9"/>
      <Setter Property="BorderBrush" Value="#4E6DE8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource Flat}">
      <Setter Property="Background" Value="#1E1E21"/>
      <Setter Property="BorderBrush" Value="#31405E"/>
      <Setter Property="Foreground" Value="#9FB6FF"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <!-- A filter chip is its category's badge: outline, fill and light ink while the filter is on, and the fill
         dropped and the ink lowered while it is off. The on fill is the badge's own lifted a little, because a
         chip has to say which state it is in where a badge sitting in a row does not. The colors are per chip
         and set in code (MainWindow.Play), so the template only says where they go - a trigger here could not
         know which category it was drawing. -->
    <Style x:Key="Chip" TargetType="ToggleButton">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid>
              <Border x:Name="b" CornerRadius="4" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="10,4">
                <ContentPresenter VerticalAlignment="Center"/>
              </Border>
              <!-- Hover is a wash laid over the chip rather than a fade of it: an unpicked chip is already the
                   quiet one, and dimming it further to say "hover" says the opposite of what a hover should. -->
              <Border x:Name="wash" CornerRadius="4" Background="Transparent" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="wash" Property="Background" Value="#16FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- The tabs are icons out of Segoe MDL2 Assets, the same font the caption buttons use, so they scale with the
         window's own text and need no artwork. Bold does nothing to an icon font, so the checked tab is said with
         the accent and a filled box rather than weight; the name lives in each one's tooltip. -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#97979F"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Margin" Value="5,0,5,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="8" Background="Transparent" Padding="13,9" Width="64" Height="44">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1C1C1F"/>
                <Setter Property="Foreground" Value="#ECECEE"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#222B45"/>
                <Setter Property="Foreground" Value="#7C9CFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- No padding on the border: it ate the height the text needed, so a box with a set height clipped whatever was
         typed into it. The content host is inset horizontally and centered vertically instead, which cannot clip. -->
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#ECECEE"/>
      <Setter Property="CaretBrush" Value="#ECECEE"/>
      <Setter Property="Background" Value="#101012"/>
      <Setter Property="BorderBrush" Value="#35353C"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" Margin="9,0" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- The same box with the text held at the top, for the few boxes that take more than a line. -->
    <Style x:Key="MultiBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="AcceptsReturn" Value="True"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" Margin="9,6"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Minimize, maximize and close, in Windows' own metrics (46x32) and its own glyph font, because they are
         no longer Windows' to draw. -->
    <Style x:Key="Caption" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Foreground" Value="#ECECEE"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#26FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#3DFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource Caption}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#E81123"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#C50F1F"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- The right-click menu on any text box. WPF builds that menu itself, and its own theme is the light one,
         which came up white over this window. -->
    <Style TargetType="ContextMenu">
      <Setter Property="Foreground" Value="#ECECEE"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="#151517" BorderBrush="#35353C" BorderThickness="1" CornerRadius="6" Padding="4"
                    SnapsToDevicePixels="True">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="#ECECEE"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="b" Background="Transparent" CornerRadius="4" Padding="11,5">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Foreground="#97979F"
                           Margin="22,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="b" Property="Background" Value="#25335C"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#5A5A62"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Background="#26262A" Margin="7,4"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- The command line preview: a read-only text box rather than a text block, so the text can be selected and
         copied by hand as well as with the button beside it. -->
    <Style x:Key="CodeBox" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="#9FB6FF"/>
      <Setter Property="SelectionBrush" Value="#3A5BD9"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="IBeam"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- A slider for the settings that are a number in a range, so a value can be dragged, or nudged with a
         controller's d-pad, rather than typed. A thin rounded track, the part behind the thumb in the accent, and
         a round thumb; WPF's own is the light theme's grey bar. -->
    <Style TargetType="Slider">
      <Setter Property="Height" Value="22"/>
      <Setter Property="Width" Value="150"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent">
              <Border Height="4" CornerRadius="2" Background="#2A2A30" VerticalAlignment="Center" Margin="7,0"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                          <Border Height="4" CornerRadius="2" Background="#5C7CE0" VerticalAlignment="Center" Margin="7,0,0,0"/>
                        </Grid>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="14" Height="14" Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="e" Fill="#DCE2FF" Stroke="#7C9CFF" StrokeThickness="1"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="e" Property="Fill" Value="#FFFFFF"/>
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="e" Property="Fill" Value="#7C9CFF"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- The deck's buttons, the way iTunes draws its own: a bare glyph, no box round it, grey until the pointer is
         on it and white then. The play button is drawn larger than the two beside it by the caller. -->
    <Style x:Key="Deck" TargetType="Button">
      <Setter Property="Foreground" Value="#B8B8C2"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="#7C9CFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#4A4A52"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- The scrubber under the deck: the settings slider drawn thinner, with a small thumb, so it reads as a
         progress line that happens to take a drag. -->
    <Style x:Key="Scrub" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
      <Setter Property="Height" Value="16"/>
      <Setter Property="Width" Value="240"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent">
              <Border Height="3" CornerRadius="1.5" Background="#2A2A30" VerticalAlignment="Center" Margin="5,0"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                          <Border Height="3" CornerRadius="1.5" Background="#8A8A96" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </Grid>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="10" Height="10" Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="e" Fill="#DCE2FF"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="e" Property="Fill" Value="#FFFFFF"/>
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="e" Property="Fill" Value="#7C9CFF"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- A controller button's name in a small pill, put beside the thing the button does: ☰ on Launch, L1 and R1
         either side of the tabs, ✕ on Add in the playlist editor. MainWindow.Pad.cs makes most of them in code
         with the same look; the two by the tabs are the only ones declared here. -->
    <Style x:Key="PadBadge" TargetType="Border">
      <Setter Property="Background" Value="#26262C"/>
      <Setter Property="BorderBrush" Value="#3F3F4A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="6,1,6,1"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#ECECEE"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="box" Width="16" Height="16" CornerRadius="4" Background="#101012" BorderBrush="#3D3D45"
                      BorderThickness="1" VerticalAlignment="Center">
                <TextBlock x:Name="tick" Text="&#x2714;" FontSize="10" Foreground="#0B0B0C" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="#7C9CFF"/>
                <Setter TargetName="box" Property="BorderBrush" Value="#7C9CFF"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="#62626C"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#ECECEE"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="b" Property="Background" Value="#313137"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#ECECEE"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid TextBlock.Foreground="#ECECEE">
              <ToggleButton Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="tb" CornerRadius="6" Background="#101012" BorderBrush="#35353C" BorderThickness="1">
                      <Path Data="M0,0 L7,0 L3.5,4.5 Z" Fill="#97979F" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="tb" Property="BorderBrush" Value="#52525C"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="10,5,26,5" VerticalAlignment="Center"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                <Border Background="#17171A" BorderBrush="#35353C" BorderThickness="1" CornerRadius="6"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,2,0,0">
                  <ScrollViewer MaxHeight="280"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <!-- By default a ListBox scrolls in whole rows, so an offset of 1 is one scene and the smooth scrolling
           below would move 72 rows rather than 72 pixels. ScrollUnit=Pixel keeps recycling virtualization (the
           list is 400+ rows) while making the offset a pixel count like every other ScrollViewer here. -->
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
      <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    </Style>
    <!-- The picked row is a filled row with an accent bar down its left edge - not WPF's dotted keyboard-focus
         rectangle (FocusVisualStyle null on the list and its items) and not a coloured rule under it. -->
    <Style TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" Background="Transparent" BorderBrush="#1B1B1E" BorderThickness="0,0,0,1" Padding="0">
              <Grid>
                <ContentPresenter/>
                <Rectangle x:Name="acc" Width="3" HorizontalAlignment="Left" Fill="#7C9CFF" Visibility="Collapsed"
                           IsHitTestVisible="False"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#19191C"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="#20263A"/>
                <Setter TargetName="acc" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- The key art, behind the header and the top of the content both. The band is taller than the header by a
         strip that reaches into the content, and Art fades the bottom of the whole thing out, so the art dissolves
         into the window instead of ending on a line. Height comes from Art, which follows the header. Nothing in
         here is hit-tested: the cards and buttons over it stay clickable. -->
    <Grid x:Name="ArtBand" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Top" IsHitTestVisible="False">
      <!-- Black under everything: the art's own right-hand half is black, so the two meet with nothing to blend. -->
      <Rectangle Fill="#000000"/>
      <!-- The game's own key art, from Steam's cache, put there at runtime; nothing ships with it. It sits on the
           left, the full height of the band; the logo is offset past Snake's face rather than over it. -->
      <Rectangle x:Name="HeroArt" HorizontalAlignment="Stretch" Visibility="Collapsed"/>
      <!-- One translucent gray over the lot, art and bare black alike, so they stay the same color while the
           black is lifted towards the rest of the window. -->
      <Rectangle Fill="#18B4B4BE"/>
    </Grid>

    <Border x:Name="HeaderBar" Grid.Row="0" Background="Transparent">
      <Grid>
        <!-- 48 at the top: 32 of caption strip that is now ours to draw on, then the 16 the bar always had, which
             leaves the logo and the tabs where they were on screen. The tabs sit hard right, in the corner the
             running/idle badge used to hold. -->
        <Grid Margin="22,48,22,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <Image x:Name="LogoArt" Height="34" HorizontalAlignment="Left" Visibility="Collapsed"/>
          <TextBlock x:Name="TitleText" Text="MGS4 DLSS Launcher" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
        </StackPanel>
        <!-- The whole header is the draggable caption, so the tabs have to be excused from it or they stop
             taking clicks. Everything else up here is a label and drags the window, which is what a bar does.
             Hard right, flush with the content edge the cards below line up on, and so under the caption buttons
             again: what keeps the two apart is size, the pills being half again as big as those and rounded.
             The bottom margin is set in code, with the logo's, so the row stays level with it. -->
        <Grid x:Name="NavTabs" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
              shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="NavPlay" Style="{StaticResource Nav}" Content="&#xE768;" ToolTip="Play"
                         IsChecked="True" GroupName="nav"/>
            <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Content="&#xE713;" ToolTip="Settings"
                         GroupName="nav"/>
            <RadioButton x:Name="NavInstall" Style="{StaticResource Nav}" Content="&#xE9D5;" ToolTip="Setup"
                         Margin="5,0,0,0" GroupName="nav"/>
          </StackPanel>
          <!-- The bumpers step the tabs, and the two badges say so where the tabs are: laid over the top outer
               corner of the first and the last tab, taking no room in the row, so the tabs do not shift when a
               pad arrives. Shown only while one is connected, in the pad's own names (LB / RB, L1 / R1) -
               MainWindow.Pad.cs fills and shows them. -->
          <Border x:Name="NavPrevHint" Style="{StaticResource PadBadge}" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Margin="-4,-8,0,0" Visibility="Collapsed">
            <TextBlock Text="LB" FontSize="10" FontWeight="SemiBold" Foreground="#ECECEE"/>
          </Border>
          <Border x:Name="NavNextHint" Style="{StaticResource PadBadge}" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="0,-8,-4,0" Visibility="Collapsed">
            <TextBlock Text="RB" FontSize="10" FontWeight="SemiBold" Foreground="#ECECEE"/>
          </Border>
        </Grid>
        </Grid>
      </Grid>
    </Border>

    <!-- Over the art, and told the chrome to let clicks through to it rather than treating it as draggable bar. -->
    <StackPanel x:Name="CaptionButtons" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <Button x:Name="MinBtn" Content="&#xE921;" Style="{StaticResource Caption}" ToolTip="Minimize"/>
      <Button x:Name="MaxBtn" Content="&#xE922;" Style="{StaticResource Caption}" ToolTip="Maximize"/>
      <Button x:Name="CloseBtn" Content="&#xE8BB;" Style="{StaticResource CaptionClose}" ToolTip="Close"/>
    </StackPanel>

    <!-- 16 at the bottom as well as the top: this view is one stretched panel rather than a stack of cards, so
         nothing else holds it off the bar underneath. The other two tabs get theirs from the last card's
         own margin. -->
    <Grid x:Name="PlayView" Grid.Row="1" Margin="22,16,22,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="370"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
              BorderThickness="1" CornerRadius="10">
        <!-- SceneCardBody is clipped to the card's rounded corners from code (MainWindow.RoundClip): the rows run
             edge to edge and a square row would otherwise poke out of the bottom corners. -->
        <Grid x:Name="SceneCardBody">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#17171A" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                  CornerRadius="10,10,0,0" Padding="14,12">
            <StackPanel>
              <Grid>
                <TextBox x:Name="Search" ToolTip="Ctrl+F from anywhere; Escape clears it"/>
                <TextBlock x:Name="SearchHint" Text="Search by scene name, stage id or act" FontSize="12"
                           Foreground="#6E6E77" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </Grid>
              <WrapPanel x:Name="Filters" Margin="0,10,0,-6"/>
            </StackPanel>
          </Border>
          <ListBox x:Name="SceneList" Grid.Row="1" Margin="0"/>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
              CornerRadius="10" Margin="14,0,0,0">
        <!-- Two rows, not three: the picked scene's head and the run options scroll as one, and only the three
             buttons are pinned. With the head fixed, a window at its minimum height had the head and the buttons
             adding up to more than the card, and Launch was the thing that fell off the bottom. -->
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ScrollViewer x:Name="PickScroll" Grid.Row="0" Style="{StaticResource OverlayScroll}"
                        VerticalScrollBarVisibility="Auto" Background="Transparent">
          <StackPanel>
          <Border Background="#17171A" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                  CornerRadius="10,10,0,0" ClipToBounds="True">
            <StackPanel>
              <!-- The picked scene's own frame, filling the head of the panel edge to edge - no padding of its
                   own, which is why the padding moved off this Border and onto the block below it. Collapsed
                   rather than blank when there is none, so a crashing id does not sit under an empty grey box. -->
              <!-- No fixed height: the box follows the panel's width at 16:9 (MainWindow keeps it so), and the
                   whole frame shows - the crop is for the row banner, not for here. -->
              <Border x:Name="PickShotBox" CornerRadius="10,10,0,0" ClipToBounds="True"
                      Background="#111114" Visibility="Collapsed">
                <!-- ImageBrush, not Image: an Image with UniformToFill anchors the bitmap at its top-left and
                     clips the rest away, so a panel wider than 16:9 showed the corner of the frame. A brush
                     centres what it crops. -->
                <Rectangle x:Name="PickShot" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Border>
            <StackPanel Margin="18,13">
              <TextBlock x:Name="PickTitle" Text="Nothing picked" FontSize="14" FontWeight="SemiBold"
                         Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="PickSub" Text="Choose a scene on the left." FontSize="11"
                         Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
              <TextBlock x:Name="PickWarn" FontSize="11" Foreground="#F2C14E" Margin="0,7,0,0"
                         TextWrapping="Wrap" Visibility="Collapsed"/>
              <StackPanel x:Name="AltRow" Orientation="Horizontal" Margin="0,9,0,0" Visibility="Collapsed">
                <TextBlock Text="Same scene, two ids:" FontSize="11" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="AltPick" Width="140" Height="26" Margin="8,0,0,0"/>
              </StackPanel>
              <!-- The catalog's names are read off the stage table and the labels file, and most scenes have
                   none at all. Anything can be given a name and a note of its own here; they are kept in the
                   preferences file, so a re-measured catalog cannot lose them. -->
              <Button x:Name="EditBtn" Content="Rename" Style="{StaticResource Link}" HorizontalAlignment="Left"
                      Margin="0,9,0,0" ToolTip="Give this scene a name and a description of your own"/>
              <StackPanel x:Name="EditPanel" Margin="0,9,0,0" Visibility="Collapsed">
                <TextBlock Text="Name" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,3"/>
                <TextBox x:Name="EditName"/>
                <TextBlock Text="Description" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,3"/>
                <TextBox x:Name="EditDesc" Style="{StaticResource MultiBox}" Height="62"/>
                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                  <Button x:Name="EditSaveBtn" Content="Save" Style="{StaticResource Primary}"/>
                  <Button x:Name="EditCancelBtn" Content="Cancel" Style="{StaticResource Flat}" Margin="8,0,0,0"/>
                  <Button x:Name="EditResetBtn" Content="Reset" Style="{StaticResource Flat}" Margin="8,0,0,0"
                          ToolTip="Drop what you have typed and go back to the catalog's own name"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
            </StackPanel>
          </Border>
            <StackPanel Margin="18,14,14,10">
              <CheckBox x:Name="OptAdvance" Content="Skip the boot prompts"/>
              <TextBlock Text="Presses through the auto-save notice and the &quot;press any button&quot; screen until the first 3D frame."
                         FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="25,3,0,13"/>
              <CheckBox x:Name="OptMashX" Content="Keep pressing E for the flashbacks"/>
              <TextBlock x:Name="MashNote" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="25,3,0,13"/>
              <CheckBox x:Name="OptEnd" Content="Close the game when gameplay starts"/>
              <TextBlock Text="For cutscenes: the HUD coming up means the scene has handed over."
                         FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="25,3,0,13"/>
              <CheckBox x:Name="OptHold" Content="Close it after a fixed time"/>
              <StackPanel Orientation="Horizontal" Margin="25,5,0,13">
                <TextBox x:Name="HoldSecs" Width="64" Text="60"/>
                <TextBlock Text="seconds into the scene" FontSize="11" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
              </StackPanel>
              <Border Height="1" Background="#202023" Margin="0,2,0,13"/>
              <CheckBox x:Name="OptRes" Content="Set the render resolution"/>
              <ComboBox x:Name="ResPick" Width="190" HorizontalAlignment="Left" Margin="25,5,0,13" SelectedIndex="3">
                <ComboBoxItem Content="1280x720 (720p)" Tag="1280x720"/>
                <ComboBoxItem Content="1920x1080 (1080p)" Tag="1920x1080"/>
                <ComboBoxItem Content="2560x1440 (1440p)" Tag="2560x1440"/>
                <ComboBoxItem Content="3840x2160 (2160p)" Tag="3840x2160"/>
              </ComboBox>
              <TextBlock Text="The same thing from a terminal" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,5"/>
              <Border Background="#101012" BorderBrush="#26262A" BorderThickness="1" CornerRadius="6" Padding="9,7">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="CmdPreview" Style="{StaticResource CodeBox}" VerticalAlignment="Center"/>
                  <Button x:Name="CmdCopyBtn" Grid.Column="1" Content="Copy" Style="{StaticResource Link}"
                          Margin="9,0,0,0" VerticalAlignment="Top"
                          ToolTip="Copy this command line to the clipboard"/>
                </Grid>
              </Border>
            </StackPanel>
          </StackPanel>
          </ScrollViewer>
          <Border Grid.Row="1" Background="#17171A" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                  CornerRadius="0,0,10,10" Padding="18,14">
            <StackPanel>
              <Button x:Name="LaunchBtn" Content="Launch" Style="{StaticResource Primary}" Padding="16,11"
                      ToolTip="Enter"/>
              <Button x:Name="StopBtn" Content="Close the game" Style="{StaticResource Flat}" Margin="0,8,0,0"/>
              <Button x:Name="ShortcutBtn" Content="Create shortcut" Style="{StaticResource Flat}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- The Play tab as it opens: the three ways to start the game, and nothing that says what is in the rest of
         it. The scene list next door names all four hundred entries and shows a frame of each, which is the whole
         story given away to anyone who has not played it - so it is behind the setting this view's own button
         writes (Settings, Launcher, "Play tab"). The cards themselves are built in MainWindow.Start.cs: they carry
         thumbnails, and the pictures are data. -->
    <Grid x:Name="StartView" Grid.Row="1" Margin="22,16,22,16" Visibility="Collapsed">
      <ScrollViewer x:Name="StartScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0" Background="Transparent">
        <!-- The tab has one thing to say, so what is left over is split above and below it rather than left in a
             heap under the last button - a little more below than above, which is where the eye reads a block as
             centred. MinHeight is the viewport, so on a window too short for the block the rows collapse to
             nothing and it simply scrolls as it did. -->
        <Grid MinHeight="{Binding ViewportHeight, ElementName=StartScroll}">
          <Grid.RowDefinitions>
            <RowDefinition Height="0.7*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
          </Grid.RowDefinitions>
          <!-- Bounded as well as centred. Stretched across a 4K-wide window the three cards become billboards with
               two lines of text lost in the middle of them; held to this, the block stays the size it was designed
               at and the extra room goes round the outside, which is what the space is for. -->
          <StackPanel Grid.Row="1" MaxWidth="1400" HorizontalAlignment="Center">
            <TextBlock Text="Start the game" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
            <TextBlock Text="Where MGS4 opens. Pick one and press Launch, or double-click it."
                       FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <!-- Three across on a wide window, fewer as it narrows: MainWindow.Start.cs sets the column count from
                 this panel's own width, so the cards never squeeze below a readable one. The negative side margins
                 cancel each card's own, so the row lines up with the card below it. -->
            <UniformGrid x:Name="StartCards" Columns="3" Margin="-7,18,-7,0"/>
            <!-- What happens when it starts, and the three ways to act on it: the shape every "do it for me" row
                 in Setup takes - the explanation on the left, the buttons on the right - rather than a checkbox and
                 a button rank stacked loose down the page. -->
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="10" Margin="0,4,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="18,15,18,15" VerticalAlignment="Center">
                  <CheckBox x:Name="StartAdvance" Content="Skip the boot prompts"/>
                  <TextBlock x:Name="StartAdvanceNote" FontSize="11" Foreground="{StaticResource Muted}"
                             MaxWidth="620" HorizontalAlignment="Left" TextWrapping="Wrap" Margin="25,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="16,15,18,15">
                  <Button x:Name="StartShortcutBtn" Content="Create shortcut" Style="{StaticResource Flat}"/>
                  <Button x:Name="StartStopBtn" Content="Close the game" Style="{StaticResource Flat}" Margin="10,0,0,0"/>
                  <Button x:Name="StartLaunchBtn" Content="Launch" Style="{StaticResource Primary}" Padding="26,11"
                          Margin="10,0,0,0" ToolTip="Enter"/>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- Setup and Settings are the same shape: a rail down the left naming every card on the page, with a search
         box over it, and the cards themselves scrolling on the right. The rail is what lets the whole page be
         seen at once - eight settings groups and seven install sections never fit a window - and a click on it
         glides the page to that card. Both rails are built in code (Ui/Rail.cs), because their rows are the
         cards' rows and the cards are data.

         Transparent rather than unset on the scrollers: a panel with no brush at all takes no hit test, so the
         gaps between the cards would hand the wheel to whatever is behind and the page would not know it had
         been scrolled over. -->
    <Grid x:Name="InstallView" Grid.Row="1" Margin="22,16,22,0" Visibility="Collapsed" AllowDrop="True"
          Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid x:Name="InstallRail" Grid.Column="0" Width="204" Margin="0,0,14,16"/>
      <ScrollViewer x:Name="InstallScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0"
                    Background="Transparent">
        <StackPanel x:Name="InstallHost"/>
      </ScrollViewer>
    </Grid>

    <Grid x:Name="SettingsView" Grid.Row="1" Margin="22,16,22,0" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border x:Name="LockBanner" Grid.Row="0" Background="#251E10" BorderBrush="#7A6027" BorderThickness="1"
              CornerRadius="8" Padding="16,11" Margin="0,0,0,14" Visibility="Collapsed">
        <TextBlock x:Name="LockText" FontSize="12" Foreground="#F2C14E" TextWrapping="Wrap"/>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="SettingsRail" Grid.Column="0" Width="204" Margin="0,0,14,16"/>
        <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0"
                      Background="Transparent">
          <StackPanel x:Name="SettingsHost"/>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="#121214" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,13">
      <!-- Three columns, the outer two sharing what the middle leaves, so the music deck in the middle sits on
           the window's own centre line whatever is either side of it. The status line and the controller guide
           stack on the left; the tab's buttons sit on the right. -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
          <TextBlock x:Name="Status" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
          <!-- Is the game up? A dot and a word under the status line: grey and Not running, amber and Launching
               from the moment Launch is pressed until mgs4.exe (or the collection's front-end, or MGS1) is seen,
               green and Running while it is. Painted by MainWindow.RefreshState from the same poll that gates Save
               and the music. -->
          <Border x:Name="GameStateTag" Background="#1C1C20" BorderBrush="#3A3A44" BorderThickness="1" CornerRadius="4"
                  Padding="8,2,9,2" Margin="0,6,0,0" HorizontalAlignment="Left" ToolTip="Whether mgs4.exe is running">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="GameStateDot" Width="7" Height="7" Fill="#6E6E77" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock x:Name="GameStateText" Text="Not running" FontSize="10" FontWeight="SemiBold" Foreground="#B8B8C2"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <!-- The music deck: the track's name over its buttons - back, pause, next under Shuffle, pause alone for
             a picked track. Built in MainWindow.Music.cs; collapsed until a track is on it. -->
        <StackPanel x:Name="Transport" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="14,0,0,0">
          <!-- The Play tab's two views, switched from the one strip that is on screen in both of them. The label
               says where it goes, not where you are, and MainWindow.Start.cs writes it. -->
          <Button x:Name="ViewSwitchBtn" Style="{StaticResource Flat}" Margin="0,0,10,0" Visibility="Collapsed"/>
          <Button x:Name="CopyBtn" Content="Copy report" Style="{StaticResource Flat}" Margin="0,0,10,0" Visibility="Collapsed"/>
          <Button x:Name="RecheckBtn" Content="Re-check  (F5)" Style="{StaticResource Primary}" Visibility="Collapsed"/>
          <Button x:Name="ReloadBtn" Content="Reload" Style="{StaticResource Flat}" Margin="0,0,10,0" Visibility="Collapsed"/>
          <Button x:Name="SaveBtn" Content="Save settings" Style="{StaticResource Primary}" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- One question, in the window's own colors. WPF's MessageBox comes up white in front of a dark window and
         cannot be styled, and the only thing this app has to ask - whether to reveal the scene list - deserves to
         be read rather than dismissed. Declared last so it paints over everything, and it covers the header too:
         the caption stays draggable because the chrome, not this Border, owns that strip. -->
    <!-- The playlist editor: the game's iPod on the left, the playlist on the right, and what is picked on either
         side can be sampled on the deck. Order of adding is the order they play in. Driven from
         MainWindow.Music.cs, by the mouse, the keyboard and a controller alike. -->
    <Border x:Name="PlaylistVeil" Grid.Row="0" Grid.RowSpan="3" Background="#D00B0B0C" Visibility="Collapsed">
      <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
              CornerRadius="12" Padding="24,20" Width="880" MaxHeight="680" Margin="22"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Playlist" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
            <TextBlock Text="Pick from the game's iPod. Tracks play in the order they were added; double-click one to add it or take it out, and Sample plays it now."
                       FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
          </StackPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="AllTracksBox" Grid.Column="0" Background="#111114" BorderBrush="#26262A" BorderThickness="1"
                    CornerRadius="8" MinHeight="300">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="AllTracksHead" Text="The iPod" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource Muted}" Margin="12,9,12,7"/>
                <ListBox x:Name="AllTracks" Grid.Row="1">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="#ECECEE" Margin="12,7"
                                   TextTrimming="CharacterEllipsis"/>
                        <!-- Tag="heart" is what the click handler looks for, so a click here hearts the track
                             instead of picking it. -->
                        <TextBlock Grid.Column="1" Tag="heart" Text="{Binding Heart}" FontSize="14"
                                   Foreground="{Binding HeartInk}" Margin="8,0,12,0" VerticalAlignment="Center"
                                   Cursor="Hand" ToolTip="Favourite - favourites head every list"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0">
              <Button x:Name="PlAddBtn" Content="Add  ►" Style="{StaticResource Flat}" ToolTip="Add the picked track to the playlist (Enter, or A on a pad)"/>
              <Button x:Name="PlSampleBtn" Content="Sample" Style="{StaticResource Flat}" Margin="0,8,0,0"
                      ToolTip="Play the picked track on the deck now (Space, or X on a pad)"/>
              <Button x:Name="PlFavBtn" Content="&#x2665;  Favourite" Style="{StaticResource Flat}" Margin="0,8,0,0"
                      ToolTip="Heart the picked track; favourites head every list (F, or Y on a pad)"/>
              <Button x:Name="PlRemoveBtn" Content="◄  Remove" Style="{StaticResource Flat}" Margin="0,8,0,0"
                      ToolTip="Take the picked track out of the playlist (Delete, or A on a pad)"/>
            </StackPanel>
            <Border x:Name="PlaylistBox" Grid.Column="2" Background="#111114" BorderBrush="#26262A" BorderThickness="1"
                    CornerRadius="8" MinHeight="300">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="PlaylistHead" Text="Playlist" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource Muted}" Margin="12,9,12,7"/>
                <ListBox x:Name="PlaylistTracks" Grid.Row="1">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" FontSize="12" Foreground="#ECECEE" Margin="12,7"
                                 TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </Grid>
          <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button x:Name="PlClearBtn" Content="Clear the playlist" Style="{StaticResource Flat}" HorizontalAlignment="Left"/>
            <Button x:Name="PlDoneBtn" Content="Done" Style="{StaticResource Primary}" HorizontalAlignment="Right"
                    ToolTip="Keep this playlist (Escape closes too)"/>
          </Grid>
        </Grid>
      </Border>
    </Border>

    <Border x:Name="Veil" Grid.Row="0" Grid.RowSpan="3" Background="#D00B0B0C" Visibility="Collapsed">
      <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
              CornerRadius="12" Padding="26,22" MaxWidth="480" Margin="22"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock x:Name="VeilTitle" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                     TextWrapping="Wrap"/>
          <TextBlock x:Name="VeilBody" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,9,0,0"
                     TextWrapping="Wrap" LineHeight="18"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="VeilCancelBtn" Content="Cancel" Style="{StaticResource Flat}"/>
            <Button x:Name="VeilOkBtn" Style="{StaticResource Primary}" Margin="10,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>

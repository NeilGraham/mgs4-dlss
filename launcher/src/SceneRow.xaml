<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
  <Grid>
    <Grid Visibility="{Binding HeaderVis}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="18"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="{Binding Chevron}" FontSize="11" Foreground="#97979F" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding HeadText}" FontSize="13" FontWeight="SemiBold" Foreground="#ECECEE"
                 VerticalAlignment="Center"/>
      <TextBlock Grid.Column="2" Text="{Binding HeadCount}" FontSize="11" Foreground="#6E6E77" VerticalAlignment="Center"/>
    </Grid>
    <Grid Visibility="{Binding SceneVis}" Margin="18,0,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <!-- What kind of scene this is, in its own color, at the head of the row: it is the first thing to know
           about a scene, so it is the first thing on the line. Fixed width so the titles beside them line up. -->
      <Border Grid.Column="0" Width="84" Margin="0,0,12,0" Padding="0,2" CornerRadius="4" VerticalAlignment="Center"
              Background="{Binding BadgeBack}" BorderBrush="{Binding BadgeEdge}" BorderThickness="1">
        <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding BadgeInk}"
                   HorizontalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1">
        <!-- The id is what you would type at a terminal, not what you read the list by, so it rides the far end
             of the title's own line in the same grey as the line under it. Inside this grid rather than a column
             of its own, which is what keeps it on the title's line instead of centered over both. The title takes
             what is left and trims, so a long name runs into the id's gap and stops. -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13" Foreground="#ECECEE"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="1" Text="{Binding Id}" FontFamily="Consolas" FontSize="12" Foreground="#97979F"
                     Margin="12,0,0,0" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="#97979F" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <!-- Tag="star" is what the click handler looks for, so a click here toggles the favorite instead of
           picking the scene. -->
      <TextBlock Grid.Column="2" Tag="star" Text="{Binding Star}" FontSize="16" Foreground="{Binding StarInk}"
                 VerticalAlignment="Center" Margin="12,0,10,0" Cursor="Hand" ToolTip="{Binding StarTip}"/>
    </Grid>
  </Grid>
</DataTemplate>
